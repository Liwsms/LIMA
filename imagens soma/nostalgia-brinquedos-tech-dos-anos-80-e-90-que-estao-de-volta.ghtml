                    clearInterval(authWatchInterval);
                    authWatchInterval = null;
                    callback('true');
                    return;
                  }
                }, 500);
              }

              function waitUserAuth(callback, startTime) {
                var logado = window.name;
                if (logado === 'true') {
                  callback(logado);
                  return;
                }
                else if (flagTimeoutNonExceeded) {
                  flagTimeoutNonExceeded = false;
                  callback('false');
                  watchNameAfterTimeout(callback);
