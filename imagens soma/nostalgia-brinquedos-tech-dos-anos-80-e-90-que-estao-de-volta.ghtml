              var isLoaded = false;

              function watchNameAfterTimeout(callback) {
                if (authWatchInterval !== null) {
                  return;
                }

                authWatchInterval = setInterval(function () {
                  var logado = window.name;
                  var isLoggedLib = false;

                  if (window.editoraGloboAuthenticationLib && window.editoraGloboAuthenticationLib.isLogged) {
