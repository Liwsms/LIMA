                var clearForAdsReady = false;
                var pendingClickTracking = false;
                var pendingViewTracking = false;
                var storyPlayers = Array.from(document.querySelectorAll('.glb-story-player'));

                function toggleStoryPlayers(isCollapsed) {
                  storyPlayers.forEach(function (storyPlayer) {
                    storyPlayer.style.display = isCollapsed ? 'none' : 'flex';

                    if(!isCollapsed) {
                      (() => {
                        const oldPlayer = document.querySelector('#glb-amp-story-player');
  
