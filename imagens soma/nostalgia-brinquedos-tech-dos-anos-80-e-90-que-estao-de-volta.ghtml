                        }
  
                        const link = oldLink.cloneNode(true);
  
                        // Cache buster para obrigar uma nova requisição.
                        const storyUrl = new URL(link.href);
                        storyUrl.searchParams.set('_story_reload', Date.now());
                        link.href = storyUrl.toString();
  
                        const newPlayer = document.createElement('amp-story-player');
  
                        // Copia somente os atributos necessários, sem os atributos internos do AMP.
                        ['id', 'width', 'height', 'layout', 'style'].forEach((attribute) => {
                          const value = oldPlayer.getAttribute(attribute);
  
                          if (value !== null) {
                            newPlayer.setAttribute(attribute, value);
                          }
                        });
  
                        // Remove classes internas geradas pelo runtime do AMP.
                        newPlayer.className = [...oldPlayer.classList]
                          .filter((className) => !className.startsWith('i-amphtml-'))
                          .join(' ');
  
                        if (config) {
                          newPlayer.appendChild(config);
                        }
  
                        newPlayer.appendChild(link);
  
                        // Para players criados dinamicamente em páginas não AMP.
                        if (typeof window.AmpStoryPlayer === 'function') {
                          new window.AmpStoryPlayer(window, newPlayer);
                        }
  
                        oldPlayer.replaceWith(newPlayer);
  
                        requestAnimationFrame(() => {
                          if (typeof newPlayer.load === 'function') {
                            newPlayer.load();
                          }
  
                          console.log('Player recriado:', newPlayer);
                          console.log('Nova URL:', link.href);
                        });
                      })();
                    }
                  });
                }

                function setArticleCroppedState(isCropped) {
                  article.classList.toggle('cropped', isCropped);
                  toggleStoryPlayers(isCropped);
                }

                document.addEventListener("clearForAds", function () {
                  clearForAdsReady = true;
                  if (pendingClickTracking) {
                    try {
                      window.dataLayer = window.dataLayer || [];
                      var hasClickEvent = (window.dataLayer || []).some(function (item) {
                        return item && item.nomeEvento === 'materia_botao_continuar_lendo_clique';
                      });
                      if (!hasClickEvent) {
                        window.dataLayer.push({ event: 'eventGen', nomeEvento: 'materia_botao_continuar_lendo_clique' });
                      } else {
                        console.log('[SEE-MORE][TRACKING] Evento de clique já existia; pulando push');
                      }
                    } catch (e) {
                      console.error('[SEE-MORE][TRACKING] Erro ao rastrear evento:', e);
                    }
                    pendingClickTracking = false;
                  }
                  if (pendingViewTracking) {
                    try {
                      window.dataLayer = window.dataLayer || [];
                      var hasViewEvent = (window.dataLayer || []).some(function (item) {
                        return item && item.nomeEvento === 'materia_botao_continuar_lendo_exibicao';
                      });
                      if (!hasViewEvent) {
                        window.dataLayer.push({ event: 'eventGen', nomeEvento: 'materia_botao_continuar_lendo_exibicao' });
                      } else {
                        console.log('[SEE-MORE][TRACKING] Evento de view já existia; pulando push');
                      }
                    } catch (e) {
                      console.error('[SEE-MORE][TRACKING] Erro ao rastrear view:', e);
                    }
                    pendingViewTracking = false;
                  }
                });

                waitUserAuth(function (logadoStr) {
                  const logadoBoolean = ("techtudo" == 'oglobo') ? logadoStr === 'true' : false;
                  if (!logadoBoolean && isPercent) {
                    isLoaded = true;
                  }

                  article.classList.add('ready');

                  if ('materia' === 'especial') {
                    setArticleCroppedState(false);
                  } else {
                    if (logadoBoolean) {
                      setArticleCroppedState(false);
                    } else {
                      if (isPercent) {
                        setArticleCroppedState(true);
                        if (isLoaded && isInWhiteCategory) {
                          // Evento de carregamento do botão (quando o botão já está presente na página)
                          try {
                            window.dataLayer = window.dataLayer || [];
                            var hasLoadedEvent = (window.dataLayer || []).some(function (item) {
                              return item && item.nomeEvento === 'materia_botao_continuar_lendo_carregado';
                            });
                            if (!hasLoadedEvent) {
                              window.dataLayer.push({ event: 'eventGen', nomeEvento: 'materia_botao_continuar_lendo_carregado' });
                            } else {
                              console.log('[SEE-MORE][TRACKING] Evento de carregamento já existia; pulando push');
                            }
                          } catch (e) {
                            console.error('[SEE-MORE][TRACKING] Erro ao rastrear carregamento:', e);
                          }
                        }

                      } else {
                        setArticleCroppedState(false);
                      }
                    }
                  }
                  
                  if (readMoreBtn) {
                    // Evento de clique
                    readMoreBtn.addEventListener(
                      'click',
                      function () {
                        readMoreBtn.textContent = 'Carregando...';
                        // Integração com rastreamento de eventos
                        try {
                          eventClick = true;
                          if (clearForAdsReady) {
                            window.dataLayer = window.dataLayer || [];
                            var hasClickEvent = (window.dataLayer || []).some(function (item) {
                              return item && item.nomeEvento === 'materia_botao_continuar_lendo_clique';
                            });
                            if (!hasClickEvent) {
                              window.dataLayer.push({ event: 'eventGen', nomeEvento: 'materia_botao_continuar_lendo_clique' });
                            } else {
                              console.log('[SEE-MORE][TRACKING] Evento de clique já existia; pulando push');
                            }
                          } else {
                            pendingClickTracking = true;
                          }
                        } catch (e) {
                          console.error('[SEE-MORE][TRACKING] Erro ao rastrear evento:', e);
                        }

                        setArticleCroppedState(false);
                      },
                      { once: true }
                    );

                    // Evento de viewability (visibilidade do botão)
                    var intersectionObserver = new IntersectionObserver(function (entries) {
                      entries.forEach(function (entry) {
                        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
                          try {
                            eventView = true;
                            if (clearForAdsReady) {
                              window.dataLayer = window.dataLayer || [];
                              var hasViewEvent = (window.dataLayer || []).some(function (item) {
                                return item && item.nomeEvento === 'materia_botao_continuar_lendo_exibicao';
                              });
                              if (!hasViewEvent) {
                                window.dataLayer.push({ event: 'eventGen', nomeEvento: 'materia_botao_continuar_lendo_exibicao' });
                              } else {
                                console.log('[SEE-MORE][TRACKING] Evento de view já existia; pulando push');
                              }
                            } else {
                              pendingViewTracking = true;
                            }
                            intersectionObserver.unobserve(entry.target);
                          } catch (e) {
                            console.error('[SEE-MORE][TRACKING] Erro ao rastrear viewability:', e);
                          }
                        }
                      });
                    }, { threshold: 0.5 });

                    intersectionObserver.observe(readMoreBtn);
                  }
                });
              }

              var article = document.getElementById('mc-article-body');

              if (article) {
                init(article);
                return;
              }

              var observer = new MutationObserver(function (_, obs) {
                var article = document.getElementById('mc-article-body');
                if (article) {
                  obs.disconnect();
                  init(article);
                }
              });

              observer.observe(document.body, {
                childList: true,
                subtree: true
              });

            } catch (e) {
              console.error('[SEE-MORE] Erro no script:', e);
            }
          })();
